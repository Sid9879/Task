PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/task_manager
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=1d

# Option 1: Cloud Redis (Upstash) — use REDIS_URL
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:PORT

# Option 2: Local Redis — use REDIS_HOST + REDIS_PORT
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
